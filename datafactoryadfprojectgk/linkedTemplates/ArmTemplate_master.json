{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "datafactoryadfprojectgk"
		},
		"AzureSynapseAnalytics1_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AzureSynapseAnalytics1'"
		},
		"Ls_gen2_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'Ls_gen2'"
		},
		"Ls_sqldatabase_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'Ls_sqldatabase'"
		},
		"AzureSynapseAnalytics1_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "myadfprojectsqlgk.database.windows.net"
		},
		"AzureSynapseAnalytics1_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sqlpooladfprojerct "
		},
		"AzureSynapseAnalytics1_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "gopikrishna"
		},
		"Ls_gen2_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adfprojectstorageacctgk.dfs.core.windows.net/"
		},
		"Ls_keyvault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://vaultadfprojectgkk.vault.azure.net/"
		},
		"Ls_sqldatabase_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "myadfprojectsql.database.windows.net"
		},
		"Ls_sqldatabase_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "adfprojectsqlgk"
		},
		"Ls_sqldatabase_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "gopikrishna"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "datafactoryadfprojectgk_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureSynapseAnalytics1_password": {
						"value": "[parameters('AzureSynapseAnalytics1_password')]"
					},
					"Ls_gen2_accountKey": {
						"value": "[parameters('Ls_gen2_accountKey')]"
					},
					"Ls_sqldatabase_password": {
						"value": "[parameters('Ls_sqldatabase_password')]"
					},
					"AzureSynapseAnalytics1_properties_typeProperties_server": {
						"value": "[parameters('AzureSynapseAnalytics1_properties_typeProperties_server')]"
					},
					"AzureSynapseAnalytics1_properties_typeProperties_database": {
						"value": "[parameters('AzureSynapseAnalytics1_properties_typeProperties_database')]"
					},
					"AzureSynapseAnalytics1_properties_typeProperties_userName": {
						"value": "[parameters('AzureSynapseAnalytics1_properties_typeProperties_userName')]"
					},
					"Ls_gen2_properties_typeProperties_url": {
						"value": "[parameters('Ls_gen2_properties_typeProperties_url')]"
					},
					"Ls_keyvault_properties_typeProperties_baseUrl": {
						"value": "[parameters('Ls_keyvault_properties_typeProperties_baseUrl')]"
					},
					"Ls_sqldatabase_properties_typeProperties_server": {
						"value": "[parameters('Ls_sqldatabase_properties_typeProperties_server')]"
					},
					"Ls_sqldatabase_properties_typeProperties_database": {
						"value": "[parameters('Ls_sqldatabase_properties_typeProperties_database')]"
					},
					"Ls_sqldatabase_properties_typeProperties_userName": {
						"value": "[parameters('Ls_sqldatabase_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "datafactoryadfprojectgk_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'datafactoryadfprojectgk_ArmTemplate_0')]"
			]
		}
	]
}